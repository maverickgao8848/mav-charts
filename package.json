{
  "name": "mav-charts",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:packages && npm run build:site",
    "build:packages": "node scripts/build-packages.mjs",
    "build:site": "vite build && node scripts/create-pages-fallback.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:packages && changeset publish",
    "check": "npm run build:packages && npm run typecheck && npm run test && npm run build:site"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "8.2.1",
    "vitest": "3.2.4"
  }
}
